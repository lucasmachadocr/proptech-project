{
  "name": "proptech-zaragoza-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "shots": "npm run build && node scripts/deck-shots.mjs",
    "video": "npm run build && node scripts/demo-video.mjs",
    "commercial:shots": "npm run build && node scripts/commercial-shots.mjs",
    "commercial": "npm run build && node scripts/commercial-video.mjs",
    "film": "npm run build && node scripts/experience-film.mjs",
    "film:stills": "npm run build && node scripts/experience-film.mjs --stills"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@huggingface/transformers": "3.8.1",
    "leaflet": "1.9.4",
    "qrcode-generator": "2.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1",
    "react-router-dom": "7.18.4",
    "zustand": "5.0.15",
    "maplibre-gl": "6.16.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "three": "0.186.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
